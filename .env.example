# Base de données
# Pour SQLite (développement local) :
DATABASE_URL="file:./dev.db"
# Pour PostgreSQL (Production Docker, Supabase, Neon) :
# DATABASE_URL="postgresql://beta_user:beta_secret_password@localhost:5432/beta_db?schema=public"

# Clé secrète NextAuth (générer avec: openssl rand -base64 32)
NEXTAUTH_SECRET="change-this-to-a-super-secret-random-key"
NEXTAUTH_URL="http://localhost:3000"

# Configuration SMTP / Emails
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="votre-user-smtp"
SMTP_PASS="votre-mot-de-passe"
SMTP_FROM="BeTA Engineering <contact@beta-engineering.com>"
ADMIN_EMAIL="contact@beta-engineering.com"

# Stockage fichiers (local ou s3/cloudinary)
UPLOAD_STORAGE="local"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

